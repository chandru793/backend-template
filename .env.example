# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_app?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=900000

# Cache
CACHE_TTL=300
CACHE_ENABLED=true

# Authentication
AUTH_ENABLED=true
JWT_SECRET=generate-a-strong-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Security
CORS_ORIGIN=http://localhost:3000

# API Documentation
SWAGGER_ENABLED=true
