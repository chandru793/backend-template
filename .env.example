# ─── Application ──────────────────────────────────────────────────────────────
# Environment: development | test | production
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000
# Host to bind (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED — app will refuse to start without this
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_app?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if Redis has no password
REDIS_PASSWORD=
# Redis database index (0–15)
REDIS_DB=0

# ─── Authentication ───────────────────────────────────────────────────────────
# Whether JWT auth middleware is active
AUTH_ENABLED=true
# REQUIRED — must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-strong-secret-at-least-32-characters
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Security ─────────────────────────────────────────────────────────────────
# Allowed CORS origin. Comma-separate multiple origins: http://a.com,http://b.com
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per time window per client
RATE_LIMIT_MAX=1000
# Time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_TIME_WINDOW=900000

# ─── Cache ────────────────────────────────────────────────────────────────────
# Set to false to disable Redis caching (falls back to direct DB queries)
CACHE_ENABLED=true
# Default cache TTL in seconds (300 = 5 minutes)
CACHE_TTL=300

# ─── API Documentation ────────────────────────────────────────────────────────
# Set to false in production — Swagger UI is disabled automatically when NODE_ENV=production
SWAGGER_ENABLED=true
